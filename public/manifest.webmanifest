{
  "name": "Karachify — Karachi directory with sources",
  "short_name": "Karachify",
  "description": "A city directory for Karachi with per-field sources: every address, opening hour, price and phone number is either linked to the page it was read from or labelled unverified. Installs as an app and opens saved pages without a connection.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "lang": "en",
  "background_color": "#F5F5F2",
  "theme_color": "#063231",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
