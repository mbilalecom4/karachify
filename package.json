{
  "name": "karachify",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Karachify — Discover Everything Karachi. Premium city-discovery platform.",
  "scripts": {
    "dev": "vite",
    "verify": "node .tools/check-data.mjs",
    "build:tier-names": "node .tools/build-tier-names.mjs",
    "measure:renditions": "node .tools/measure-renditions.mjs --limit=60 --write",
    "icons": "node .tools/build-icons.mjs",
    "build": "node .tools/check-data.mjs && tsc -b && vite build && node .tools/prerender.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "serve:dist": "node .tools/serve-dist.mjs",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "lucide-react": "^0.451.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
